
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Mensagem do Dia</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <main class="container min-vh-100 d-flex
                 justify-content-center align-items-center py-5">

        <section class="card mensagem-card shadow-lg border-0">
            <div class="card-body text-center p-4 p-md-5">

                <div class="icone mb-3">✦</div>

                <p class="text-uppercase subtitulo">
                    Uma pausa para refletir
                </p>

                <h1 class="display-5 fw-bold mb-4">
                    Mensagem do Dia
                </h1>

                <div class="linha mb-4"></div>

                <% if (erro) { %>
                    <div class="alert alert-warning" role="alert">
                        <%= erro %>
                    </div>
                <% } else { %>
                    <blockquote class="frase mb-4">
                        “<%= mensagem %>”
                    </blockquote>
                    <p class="autor">Ron Swanson</p>
                <% } %>

                <form action="/" method="GET" class="mt-4">
                    <button type="submit"
                            class="btn btn-mensagem btn-lg w-100">
                        Nova mensagem ↻
                    </button>
                </form>

                <p class="rodape mt-4 mb-0">
                    Uma frase de cada vez.
                </p>

            </div>
        </section>

    </main>
</body>
</html>
